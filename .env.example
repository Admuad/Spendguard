# Copy this file to `.env` and fill in the values. NEVER commit `.env`.
# The deployer key must be a TESTNET-ONLY key. It is never written anywhere
# except your local `.env`, which is gitignored.

# Testnet-only deployer private key (no 0x prefix needed; forge accepts both).
PRIVATE_KEY=
# tUSD8 on Aevum testnet (chain 44005), 6 decimals.
TUSD8_ADDRESS=0x456569838f1d43009A91ebA4263147Afd7233483
