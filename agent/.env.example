# SpendGuard demo agent configuration.
# Copy nothing: set these in the environment of the process that runs the
# agent. Never commit a filled-in copy of this file. Never put the owner
# key here: the agent only ever holds a scoped session key.

# Required. The session key the owner granted a session to. 0x-prefixed,
# 64 hex characters. The agent never prints this value.
SESSION_KEY_PRIVATE_KEY=

# Required. The merchant address this payment goes to. It must be on the
# session allowlist or the contract reverts the payment.
AGENT_RECIPIENT=

# Required. Decimal amount in tUSD8, at most 6 decimals. Examples: 0.25, 1.
AGENT_AMOUNT=

# Required. A unique ID for this payment, up to 128 letters, digits, dots,
# dashes, or underscores. A paid invoice ID is never paid twice.
AGENT_INVOICE_ID=

# Optional. Defaults to the Aevum testnet public RPC.
# RPC_URL=https://rpc-test.qday.info

# Optional. Defaults to the deployed SpendGuard vault.
# VAULT_ADDRESS=0x9a113999851e446a7ab516472e2dae743fc2a0ca

# Optional. Defaults to agent-ledger.jsonl in the working directory.
# AGENT_LEDGER_PATH=agent-ledger.jsonl
